          "query": "from(bucket: \"alphaess\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"dispatch_state\" and r._field == \"decision_kind\")\n  |> last()\n  |> keep(columns: [\"_value\"])\n",
