            "uid": "${DS_ALPHAESS}"
          },
          "query": "from(bucket: \"alphaess\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"dispatch_state\" and r._field == \"live\")\n  |> last()\n",
          "refId": "A"
        }
      ],
      "title": "Mode",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_ALPHAESS}"
      },
      "description": "Seconds since the loop last published anything. It should sit under 60. Past 180 - two missed ticks, the same threshold review-dry-run.py and Kuma monitor #5 use - it is not jitter. This reads over ten minutes where the rest of the row reads five, so it keeps counting after the verdict has gone to NO DISPATCHER: 'down, and for six minutes' is more use than 'down' beside a blank.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "noValue": "silent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
