          "query": "from(bucket: \"alphaess\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"dispatch_state\" and r._field == \"plan_run\")\n  |> last()\n  |> map(fn: (r) => ({ _time: r._time,\n       _value: float(v: int(v: now()) - int(v: time(v: r._value))) / 1000000000.0 }))\n  |> keep(columns: [\"_value\"])\n",
          "refId": "A"
        }
