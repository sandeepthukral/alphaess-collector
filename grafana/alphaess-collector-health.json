          "datasource": {
            "type": "influxdb",
            "uid": "${DS_ALPHAESS}"
          },
          "query": "from(bucket: \"alphaess\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"collector_health\" and r.event == \"failure\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)\n  |> keep(columns: [\"_time\", \"error_class\", \"failures\", \"error\"])\n  |> yield(name: \"recent_failures\")",
          "refId": "A"
