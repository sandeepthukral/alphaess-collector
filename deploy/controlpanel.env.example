# controlpanel's OWN env file for `docker compose --env-file`, DELIBERATELY SEPARATE from
# the real .env at the repo root.
#
# WHY THIS FILE EXISTS. Going live/dry-run (controlpanel/docker_actions.py:set_dispatch_live)
# runs `docker compose -f docker-compose.yml -f deploy/dispatch-live.override.yml up -d
# --force-recreate dispatch` from INSIDE the controlpanel container. `docker compose`
# interpolates every `${...}` in docker-compose.yml at parse time, for every service in the
# file, even though only `dispatch` is being recreated -- so it needs an env file that
# resolves ALL of them, not just dispatch's own. Handing it the real .env would work, but
# would also hand controlpanel read access to ALPHAESS_APP_SECRET, MIJNBATTERIJ_API_KEY, and
# the collector/grafana/pusher InfluxDB tokens -- exactly the credentials this design
# otherwise goes out of its way to keep off this container (backfills run via `docker exec`
# into the already-running collector/mijnbatterij containers for the same reason).
#
# So this file carries two different kinds of value:
#
#   1. dispatch's OWN variables, with their REAL values, copied from the real .env. These are
#      not placeholders -- `--force-recreate dispatch` builds the recreated container's actual
#      environment from THIS file, so a placeholder here would silently overwrite the real
#      inverter IP / token / heartbeat URLs the next time anyone uses the live toggle.
#   2. every OTHER service's `:?`-guarded variable, with a harmless non-empty placeholder --
#      needed only so compose's interpolation does not fail on a variable it will never
#      actually use, since no other service is being recreated.
#
# tests/test_controlpanel_env_completeness.py fails the build if a variable is added to
# docker-compose.yml in either category without a matching line here -- keep them in sync by
# hand, the test only catches a missing key, not a stale value.
#
# Copy to deploy/controlpanel.env (gitignored) and fill in the real values from your NAS's
# .env for the "real" section below.

# --- dispatch's own variables: REAL values, kept in sync with .env by hand ------------------
INVERTER_IP=192.168.68.151
INFLUX_ORG=home
INFLUX_BUCKET=alphaess
PLANNING_BUCKET=planning
INFLUX_TOKEN_DISPATCH=read_planning_read_write_alphaess
ALPHAESS_SYS_SN=your_system_serial_number
BATTERY_CAPACITY_WH=27900
TRANSLATE_INTERVAL_S=3600
SOC_FLOOR_PCT=10
KUMA_ADDR=host-gateway
TZ=Europe/Amsterdam
DISPATCH_LIVE=0
PLAN_INFLUX_HEARTBEAT_URL=
SLOTS_WRITTEN_HEARTBEAT_URL=
SLOTS_FRESH_HEARTBEAT_URL=
DISPATCHER_ALIVE_HEARTBEAT_URL=
DISPATCH_CONFIRMED_HEARTBEAT_URL=
INVERTER_NOT_HIJACKED_HEARTBEAT_URL=
SOC_FLOOR_HEARTBEAT_URL=

# --- other services' required (":?") variables: placeholders only, never used for real ------
# controlpanel never recreates collector, grafana, pusher or itself via this mechanism, so
# these values are never applied anywhere -- they exist only so compose's whole-file
# interpolation does not abort. Any non-empty string satisfies the guard.
INFLUX_TOKEN_COLLECTOR=unused-placeholder
INFLUX_TOKEN_GRAFANA=unused-placeholder
INFLUX_TOKEN_PUSHER=unused-placeholder
GRAFANA_ADMIN_PASSWORD=unused-placeholder
INFLUX_TOKEN_CONTROLPANEL=unused-placeholder

# HOST_REPO_PATH is a PARTIAL exception to "placeholder only": it also guards controlpanel's
# OWN volume block (see docker-compose.yml), and unlike a plain env var, `docker compose`
# validates bind-mount SYNTAX for every service at parse time even though this invocation
# never recreates controlpanel. A short placeholder like the others above is not just unused
# here -- it produces a relative-looking path ("unused-placeholder/docker-compose.yml") that
# compose reads as a reference to an undefined NAMED VOLUME and refuses to parse at all. Set
# it to the same real absolute path as `HOST_REPO_PATH` in the real `.env` (confirmed
# unused-for-real by the same reasoning as the rest of this section).
HOST_REPO_PATH=/volume1/docker/alphaess-collector
