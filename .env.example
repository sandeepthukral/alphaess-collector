# AlphaESS Open API credentials (from https://open.alphaess.com/)
ALPHAESS_APP_ID=your_app_id
ALPHAESS_APP_SECRET=your_app_secret
ALPHAESS_SYS_SN=your_system_serial_number

# InfluxDB
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change_me
INFLUX_ORG=home
INFLUX_BUCKET=alphaess
INFLUX_PORT=8086

# The all-powerful admin token -- scope: rw every bucket, plus operations no
# scoped token can do. It creates and drops buckets, mints other tokens,
# deletes data. Used to initialise InfluxDB on first start and for manual
# `influx` CLI work -- and by nothing else. Every service gets its own scoped
# token below. See DEPLOY.md, "Scoped tokens".
INFLUX_TOKEN=generate_a_long_random_token_here

# Per-service tokens, minted with `influx auth create` after first start (the
# recipe is in DEPLOY.md). Not optional and deliberately without fallbacks: a
# service that silently falls back to the admin token is the failure this is
# meant to prevent.
#
# collector -- scope: rw alphaess.
# Runs collector.py, prices.py and pricing.py, so it needs read as well as
# write: pricing.py queries daily_cost to skip days it has already computed,
# and reads power_readings and market_price to compute them.
INFLUX_TOKEN_COLLECTOR=read_write_on_the_alphaess_bucket

# awtrix-pusher -- scope: r alphaess.
# Only ever reads the newest sample.
INFLUX_TOKEN_PUSHER=read_only_on_the_alphaess_bucket

# Grafana -- scope: r alphaess, r planning.
# Read-only, across every bucket it must chart. The battery-plan and
# battery-score dashboards query the `planning` bucket (written by the
# battery-planning repo), so a token scoped to alphaess alone leaves both of
# them empty. Anyone reaching the Grafana UI can issue arbitrary Flux through
# the datasource proxy, so this is the token most worth keeping narrow.
INFLUX_TOKEN_GRAFANA=read_only_on_alphaess_and_any_other_bucket

# Nightly InfluxDB backup (scripts/backup-influxdb.sh via DSM Task Scheduler).
# Host directory bind-mounted into the influxdb container at /backups. Point
# this at a folder your NAS backup tool (e.g. Google Drive sync) already
# covers, so InfluxDB backups ride along automatically. See BACKUP-DATABASE.MD.
BACKUP_HOST_DIR=/volume1/web/googleDrive/alphaess-influxdb-backups
# Local backups older than this are pruned after each run (the external
# backup target keeps its own history independently).
BACKUP_RETENTION_DAYS=7

# Grafana (bundled instance). Host port the dashboard is published on. Change
# it if 3000 is already taken on the host -- e.g. on a NAS already running
# another Grafana (TeslaMate) on 3000, set GRAFANA_PORT=3001.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin

# Required, with no fallback in docker-compose.yml: Grafana is the only service
# on the LAN, and it fronts a datasource proxy that can query every bucket. If
# this is unset, every `docker compose` command in this directory fails with
# "set GRAFANA_ADMIN_PASSWORD in .env" rather than Grafana coming up on
# admin/admin. Change this value before the first `up`.
GRAFANA_ADMIN_PASSWORD=change_me

# Container clock, for log timestamps only -- so `docker compose logs` lines up
# with Grafana and with Uptime Kuma notifications instead of trailing them by
# an hour or two. Set it to the host's own zone. Nothing date-sensitive depends
# on it: pricing.py and daily-savings.sh pin Europe/Amsterdam themselves and
# InfluxDB stores UTC, so changing this cannot move a day boundary.
TZ=Europe/Amsterdam

# Collector
POLL_INTERVAL_SECONDS=30
LOG_LEVEL=INFO

# Ceiling on the exponential backoff between failed polls. Also sets how big a
# gap an outage leaves in the data: at 120s a run of k failed polls leaves
# 30 + 60 + 120*(k-1) seconds, so eleven consecutive failures fit under the
# 1200s PRICING_MAX_GAP_S gate that decides whether a day is priced at all.
# Raising this trades savings data for API politeness -- raise
# PRICING_MAX_GAP_S with it, or days start disappearing from the dashboard.
MAX_BACKOFF_SECONDS=120

# Expected maximum link MTU inside the collector container. Must match the
# com.docker.network.driver.mtu driver_opt on alphaess-net in
# docker-compose.yml. The collector logs its actual MTU at startup and warns
# if it is larger -- which means the docker network was created before that
# cap was added and needs `docker compose down && docker compose up -d`.
EXPECTED_MAX_MTU=1400

# Battery-savings analysis (pricing.py)
# Usable battery capacity in kWh, used only to express the daily SoC change in
# kWh on the dashboard. Optional. NOTE: on this system the reported SoC appears
# compressed (moves ~1/2.8 of measured throughput), so treat the kWh figure as
# directional. Euro results do not depend on it.
BATTERY_CAPACITY_KWH=27.9

# Complete-day gates (pricing.py). A day failing either is left out of
# daily_cost entirely rather than published with a caveat -- the dashboard has
# no way to show "this figure is shakier than the others", so a day is either
# trustworthy or absent.
#
# Fraction of the day that must carry power samples. 0.98 of a 30 s cadence
# leaves room for roughly half an hour of scattered misses across 24 hours.
PRICING_MIN_COVERAGE=0.98
# Largest single gap tolerated, in seconds. Distinct from the above because the
# shape matters, not just the total: 20 minutes missing in one block spans real
# price movement that interpolation invents, while the same 20 minutes scattered
# a poll at a time does not. This is the knob coupled to MAX_BACKOFF_SECONDS
# above -- raise them together or not at all.
PRICING_MAX_GAP_S=1200
#
# There is a third gate, on price coverage, deliberately NOT settable here; it
# lives as a constant in pricing.py. The two above trade precision for keeping
# a day, which is a real operational call. That one does not degrade -- an
# unpriced hour costs zero in both models, so below it the euro figure is not
# noisier, it is wrong. See the comment at its definition.
#
# NOTE: changing either gate does not re-score history. pricing.py skips days
# already computed at the current model_version, and the gate values are not
# recorded on the row -- so loosening one leaves previously rejected days out
# until you `--backfill` them, and tightening one leaves already-published days
# in place.

# Optional dead-man's switch: URL of an Uptime Kuma "Push" monitor. The
# collector pings it after each successful InfluxDB write, so a stuck-but-alive
# collector (API auth expired, writes failing) still trips the monitor. Leave
# blank to disable. Set the Kuma monitor's grace period > POLL_INTERVAL_SECONDS.
# Paste the URL exactly as Kuma shows it; its ?status=up&msg=OK&ping= query is
# replaced per ping, not appended to. Quote it -- 'http://...&msg=OK&ping=' --
# because the & separators make `. ./.env` in a shell background the line and
# lose the value; compose strips the quotes back off, so the container is
# unaffected either way.
# From the 2nd consecutive failure the collector also pushes status=down with
# the error as the message, so the notification names the fault ("ReadTimeout
# ... 30s") instead of only "no ping received"; recovery pings carry how long
# the outage lasted. Nothing to configure in Kuma for that.
#
# After 3 consecutive failures the collector probes DNS for the API host and
# one unrelated HTTPS endpoint, then logs whether the fault is local or at
# AlphaESS and appends the verdict ([upstream] / [local-dns] / [local-network])
# to the alert. The control endpoint is addressed by IP so it does not depend
# on DNS; override only if 1.1.1.1 is blocked on your network.
DIAGNOSTIC_URL=https://1.1.1.1/
HEARTBEAT_URL=

# Conversion-loss analysis (efficiency.py)
# Back-fills AlphaESS's own metered house load (getOneDayPowerBySn) and daily
# energy totals (getOneDateEnergyBySn) so the inverter's conversion and standby
# losses become measurable. They are invisible in power_readings alone, where
# load_power_w is the exact identity pv + grid + battery rather than a
# measurement. See DEPLOY.md, "Nightly conversion-loss update".
#
# Complete-day gates, same all-or-nothing logic as the pricing gates above.
# Fraction of the day the 5-minute metered series must cover. A thin series
# under-states measured load and therefore over-states the loss -- it fails in
# the flattering direction, which is the one nobody investigates.
EFFICIENCY_MIN_COVERAGE=0.98
# Largest tolerated gap in the metered series, in seconds. Native cadence 300 s.
EFFICIENCY_MAX_GAP_S=1800
# Maximum median disagreement, in percentage points, between the SoC AlphaESS
# reports in the 5-minute series and the SoC already in power_readings at the
# same instant. These are the same physical quantity by two paths, so this is
# the only available check on the one thing efficiency.py has to assume: that
# uploadTime is stamped in the system's local timezone. A one-hour error moves
# SoC by tens of points on any day the battery cycles, so a DST mis-parse fails
# loudly here instead of being stored as a plausible-looking loss.
# Diagnose a day rejected here with `python efficiency.py --check-alignment`.
EFFICIENCY_MAX_SOC_ALIGN_PP=2.0
#
# Despiking for the metered load. AlphaESS intermittently returns a wildly
# wrong value in a single 5-minute `load` record -- 5832 W where the 30 s series
# says the house was drawing ~500 W. Measured across 19 days: 26 records in
# 5430 (0.48%), worth 8.7 kWh of phantom load, 14 of them on 2026-08-01 alone,
# which took that day's conversion loss to -4.59 kWh.
#
# A record is dropped when its load exceeds the largest derived load anywhere in
# its own 5-minute neighbourhood by both FACTOR x and FLOOR_W. The test is
# against the derived series, not against neighbouring metered records, because
# that is the physically meaningful one: conversion loss makes derived >=
# metered, in that direction only, so a record several times *above* derived is
# not measuring loss whatever else it is. A genuine appliance spike appears in
# both series and is kept. Set FACTOR=0 to disable the filter entirely.
#
# Dropped records are still stored in metered_power -- the filter applies to the
# integral, not to the archive -- and the count lands in daily_energy as
# series_dropped. A day where more than MAX_SPIKE_FRACTION of records are
# implausible is rejected outright: deleting a tenth of a day is not a repair.
EFFICIENCY_SPIKE_FACTOR=4.0
EFFICIENCY_SPIKE_FLOOR_W=1500
EFFICIENCY_MAX_SPIKE_FRACTION=0.10

# AlphaESS API politeness for efficiency.py. It shares an appId rate budget
# with the live 30 s poll loop in the same image, so a greedy backfill pushes
# collection into its backoff ladder and punches gaps in power_readings --
# which pricing.py then charges against PRICING_MAX_GAP_S, costing whole days
# of daily_cost. 10 s is the upstream alphaess-openAPI library's advice.
ALPHAESS_MIN_REQUEST_INTERVAL_S=10
ALPHAESS_MAX_RETRIES=4
# API codes worth retrying. 6053 is "the request was too fast". 6006
# (timestamp/clock skew) is deliberately absent: retrying a signature the
# server calls stale only burns the rate budget.
ALPHAESS_RETRY_CODES=6053

# Optional dead-man's switch for the nightly efficiency job: a second Uptime
# Kuma "Push" monitor, separate from HEARTBEAT_URL above (that one fires every
# 30 s from the live collector; this one once a night). Same quoting caveat.
# Set the Kuma monitor to Heartbeat Interval 86400, Retries 1, Retry Interval
# 3600 so it trips ~26 h after the last good night.
# The job pushes status=down with the reason when a run writes nothing, which
# is what catches its nastiest failure: a run where every day fails the quality
# gate exits 0 and looks like success to anything watching only the exit code.
EFFICIENCY_HEARTBEAT_URL=

# AWTRIX pusher (Ulanzi TC001 / AWTRIX 3 clock) — optional.
# LAN IP (or full URL) of the clock, e.g. AWTRIX_HOST=192.168.1.42. Reserve a
# static IP for it on your router. Leave blank to disable (service idles).
AWTRIX_HOST=
PUSH_INTERVAL_SECONDS=30
STALE_AFTER_SECONDS=180
# HTTP timeout per request to the clock. Raise only if the device sits on a
# slow or congested LAN segment.
AWTRIX_TIMEOUT_SECONDS=5
# Optional AWTRIX icons per app. Value = an icon name/ID present on the device
# (upload via the AWTRIX web UI Icons page, which can fetch by LaMetric ID from
# https://developer.lametric.com/icons). Blank = text label instead of an icon.
AWTRIX_ICON_SOC=
AWTRIX_ICON_PV=
AWTRIX_ICON_GRID=
AWTRIX_ICON_LOAD=
